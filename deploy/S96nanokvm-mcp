#!/bin/sh
# NanoKVM MCP sidecar init script. Install as /etc/init.d/S96nanokvm-mcp.
DAEMON=/root/nanokvm-mcp/nanokvm-mcp
CONF=/root/nanokvm-mcp/nanokvm-mcp.env
PIDFILE=/var/run/nanokvm-mcp.pid
LOG=/data/nanokvm-mcp/daemon.log

start() {
	printf 'Starting nanokvm-mcp: '
	# shellcheck disable=SC1090
	[ -f "$CONF" ] && . "$CONF"
	export NANOKVM_HOST NANOKVM_USER NANOKVM_PASS NANOKVM_MCP_BIND \
		NANOKVM_MCP_TOKEN NANOKVM_MCP_READONLY NANOKVM_MCP_AUDIT \
		NANOKVM_MCP_AUDIT_FULL NANOKVM_HTTPS NANOKVM_VERIFY_SSL GOMEMLIMIT
	: "${GOMEMLIMIT:=24MiB}"
	export GOMEMLIMIT
	mkdir -p /data/nanokvm-mcp
	# Run via `sh -c 'exec ... >> log'` so the daemon's stdout/stderr reach $LOG.
	# busybox start-stop-daemon -b redirects the child's stdio to /dev/null before
	# exec, so redirecting start-stop-daemon itself (">>$LOG") captures nothing;
	# reopening the fds inside the exec'd shell survives the daemonize. exec keeps
	# the PID stable so -m records the daemon's real PID.
	# The trailing redirections detach start-stop-daemon itself from the calling
	# terminal; without them, `ssh <device> /etc/init.d/S96nanokvm-mcp restart`
	# hangs because the daemonized child keeps the ssh channel's fds open.
	start-stop-daemon -S -q -b -m -p "$PIDFILE" -x /bin/sh -- -c "exec '$DAEMON' >> '$LOG' 2>&1" </dev/null >/dev/null 2>&1
	echo OK
}
stop() {
	printf 'Stopping nanokvm-mcp: '
	start-stop-daemon -K -q -p "$PIDFILE"
	echo OK
}
case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
